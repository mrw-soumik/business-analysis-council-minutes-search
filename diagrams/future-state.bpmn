<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FutureState" targetNamespace="https://github.com/mrw-soumik/business-analysis-council-minutes-search" exporter="business-analysis-council-minutes-search/tools/bpmn" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_FutureState">
    <bpmn:documentation>Future-state process map for the St. John's Council Minutes Assistant. Annotations reference requirement IDs in 01-business-requirements-document.md. Independent portfolio project, not affiliated with or endorsed by the City of St. John's.</bpmn:documentation>
    <bpmn:participant id="Participant_City_ToBe" name="City of St. John's" processRef="Process_City_ToBe" />
    <bpmn:participant id="Participant_User_ToBe" name="Resident, journalist or community volunteer" processRef="Process_User_ToBe" />
    <bpmn:participant id="Participant_Assistant_ToBe" name="St. John's Council Minutes Assistant" processRef="Process_Assistant_ToBe" />
    <bpmn:participant id="Participant_Escribe_ToBe" name="eSCRIBE public meetings portal (official minutes, unchanged)" />
    <bpmn:messageFlow id="Message_ToBe_01" name="Enquiry" sourceRef="ToBe_AskCity" targetRef="ToBe_City_EnquiryReceived" />
    <bpmn:messageFlow id="Message_ToBe_02" name="Reply" sourceRef="ToBe_City_Reply" targetRef="ToBe_AskCity" />
    <bpmn:messageFlow id="Message_ToBe_03" name="Question and date range" sourceRef="ToBe_Ask" targetRef="ToBe_QuestionReceived" />
    <bpmn:messageFlow id="Message_ToBe_04" name="Response: answer or not found" sourceRef="ToBe_ResponseSent" targetRef="ToBe_Response" />
    <bpmn:messageFlow id="Message_ToBe_05" name="Request meeting list" sourceRef="ToBe_CheckPortal" targetRef="Participant_Escribe_ToBe" />
    <bpmn:messageFlow id="Message_ToBe_06" name="Minutes (PDF, HTML)" sourceRef="Participant_Escribe_ToBe" targetRef="ToBe_Download" />
  </bpmn:collaboration>
  <bpmn:process id="Process_City_ToBe" name="Answer a routine enquiry (to-be)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_City_ToBe">
      <bpmn:lane id="Lane_Staff_ToBe" name="City Clerk's office and 311">
        <bpmn:flowNodeRef>ToBe_City_EnquiryReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_City_AskAssistant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_City_Reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_City_Closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ToBe_City_EnquiryReceived" name="Enquiry received">
      <bpmn:outgoing>Flow_ToBe_City_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ToBe_City_EnquiryReceived" />
    </bpmn:startEvent>
    <bpmn:userTask id="ToBe_City_AskAssistant" name="Ask the assistant and verify">
      <bpmn:incoming>Flow_ToBe_City_01</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_City_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="ToBe_City_Reply" name="Reply with the official link">
      <bpmn:incoming>Flow_ToBe_City_02</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_City_03</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ToBe_City_Closed" name="Enquiry closed">
      <bpmn:incoming>Flow_ToBe_City_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToBe_City_01" sourceRef="ToBe_City_EnquiryReceived" targetRef="ToBe_City_AskAssistant" />
    <bpmn:sequenceFlow id="Flow_ToBe_City_02" sourceRef="ToBe_City_AskAssistant" targetRef="ToBe_City_Reply" />
    <bpmn:sequenceFlow id="Flow_ToBe_City_03" sourceRef="ToBe_City_Reply" targetRef="ToBe_City_Closed" />
    <bpmn:textAnnotation id="Annotation_ToBe_Staff">
      <bpmn:text>Staff use the same assistant (BR-03)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Annotation_ToBe_Staff" associationDirection="None" sourceRef="ToBe_City_AskAssistant" targetRef="Annotation_ToBe_Staff" />
  </bpmn:process>
  <bpmn:process id="Process_User_ToBe" name="Find a council decision (to-be)" isExecutable="false">
    <bpmn:startEvent id="ToBe_Start" name="Question about a council decision">
      <bpmn:outgoing>Flow_ToBe_User_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ToBe_JoinAsk">
      <bpmn:incoming>Flow_ToBe_User_01</bpmn:incoming>
      <bpmn:incoming>Flow_ToBe_User_13</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ToBe_Ask" name="Ask a question (optional dates)">
      <bpmn:incoming>Flow_ToBe_User_02</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="ToBe_Response" name="Response received">
      <bpmn:incoming>Flow_ToBe_User_03</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ToBe_Response" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="ToBe_AnswerFound" name="Answer found?">
      <bpmn:incoming>Flow_ToBe_User_04</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_User_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ToBe_Review" name="Review answer and excerpts">
      <bpmn:incoming>Flow_ToBe_User_05</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ToBe_Verify" name="Verify or quote?">
      <bpmn:incoming>Flow_ToBe_User_07</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_User_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ToBe_OpenOfficial" name="Open the official page">
      <bpmn:incoming>Flow_ToBe_User_08</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ToBe_JoinDone">
      <bpmn:incoming>Flow_ToBe_User_09</bpmn:incoming>
      <bpmn:incoming>Flow_ToBe_User_10</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ToBe_EndFound" name="Decision found">
      <bpmn:incoming>Flow_ToBe_User_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ToBe_NextStep" name="Next step?">
      <bpmn:incoming>Flow_ToBe_User_06</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_User_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ToBe_AskCity" name="Contact the Clerk's office or 311">
      <bpmn:incoming>Flow_ToBe_User_12</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_User_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ToBe_EndAnswered" name="Answer received">
      <bpmn:incoming>Flow_ToBe_User_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToBe_User_01" sourceRef="ToBe_Start" targetRef="ToBe_JoinAsk" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_02" sourceRef="ToBe_JoinAsk" targetRef="ToBe_Ask" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_03" sourceRef="ToBe_Ask" targetRef="ToBe_Response" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_04" sourceRef="ToBe_Response" targetRef="ToBe_AnswerFound" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_05" name="Yes" sourceRef="ToBe_AnswerFound" targetRef="ToBe_Review" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_06" name="No" sourceRef="ToBe_AnswerFound" targetRef="ToBe_NextStep" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_07" sourceRef="ToBe_Review" targetRef="ToBe_Verify" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_08" name="Yes" sourceRef="ToBe_Verify" targetRef="ToBe_OpenOfficial" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_09" name="No" sourceRef="ToBe_Verify" targetRef="ToBe_JoinDone" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_10" sourceRef="ToBe_OpenOfficial" targetRef="ToBe_JoinDone" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_11" sourceRef="ToBe_JoinDone" targetRef="ToBe_EndFound" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_12" name="Ask the City" sourceRef="ToBe_NextStep" targetRef="ToBe_AskCity" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_13" name="Rephrase" sourceRef="ToBe_NextStep" targetRef="ToBe_JoinAsk" />
    <bpmn:sequenceFlow id="Flow_ToBe_User_14" sourceRef="ToBe_AskCity" targetRef="ToBe_EndAnswered" />
    <bpmn:textAnnotation id="Annotation_ToBe_Citation">
      <bpmn:text>Link opens the official document at the cited page (FR-02)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Annotation_ToBe_Citation" associationDirection="None" sourceRef="ToBe_OpenOfficial" targetRef="Annotation_ToBe_Citation" />
  </bpmn:process>
  <bpmn:process id="Process_Assistant_ToBe" name="Answer questions and keep the index current (to-be)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Assistant_ToBe">
      <bpmn:lane id="Lane_Answer_ToBe" name="Answer service">
        <bpmn:flowNodeRef>ToBe_QuestionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_Retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_PassagesFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_CheckCitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_AllSupported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_Format</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_JoinNotFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_NotFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_JoinRespond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_ResponseSent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ingest_ToBe" name="Ingestion pipeline">
        <bpmn:flowNodeRef>ToBe_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_CheckPortal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_NewMinutes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_EndNoChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_Download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_BuildIndex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_QualityChecks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_QualityGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_EndUpdated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_KeepPrevious</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ToBe_EndAlerted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ToBe_QuestionReceived" name="Question received">
      <bpmn:outgoing>Flow_ToBe_Ans_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ToBe_QuestionReceived" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ToBe_Retrieve" name="Retrieve passages (hybrid search)">
      <bpmn:incoming>Flow_ToBe_Ans_01</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_02</bpmn:outgoing>
      <bpmn:property id="Property_ToBe_Retrieve" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInput_ToBe_Index"><bpmn:sourceRef>ToBe_Index</bpmn:sourceRef><bpmn:targetRef>Property_ToBe_Retrieve</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBe_PassagesFound" name="Passages found?">
      <bpmn:incoming>Flow_ToBe_Ans_02</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_Ans_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ToBe_Draft" name="Draft answer from passages only">
      <bpmn:incoming>Flow_ToBe_Ans_03</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ToBe_CheckCitations" name="Check every claim is cited">
      <bpmn:incoming>Flow_ToBe_Ans_05</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBe_AllSupported" name="Claims cited?">
      <bpmn:incoming>Flow_ToBe_Ans_06</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_Ans_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ToBe_Format" name="Add citations, excerpts and links">
      <bpmn:incoming>Flow_ToBe_Ans_07</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBe_JoinNotFound">
      <bpmn:incoming>Flow_ToBe_Ans_04</bpmn:incoming>
      <bpmn:incoming>Flow_ToBe_Ans_08</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ToBe_NotFound" name="Prepare a &quot;not found&quot; reply">
      <bpmn:incoming>Flow_ToBe_Ans_09</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBe_JoinRespond">
      <bpmn:incoming>Flow_ToBe_Ans_10</bpmn:incoming>
      <bpmn:incoming>Flow_ToBe_Ans_11</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ans_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ToBe_ResponseSent" name="Response sent">
      <bpmn:incoming>Flow_ToBe_Ans_12</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ToBe_ResponseSent" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="ToBe_Index" name="Minutes index" />
    <bpmn:startEvent id="ToBe_Schedule" name="Daily schedule">
      <bpmn:outgoing>Flow_ToBe_Ing_01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ToBe_Schedule"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ToBe_CheckPortal" name="Check portal for new minutes">
      <bpmn:incoming>Flow_ToBe_Ing_01</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ing_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBe_NewMinutes" name="New minutes?">
      <bpmn:incoming>Flow_ToBe_Ing_02</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ing_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_Ing_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ToBe_EndNoChange" name="No change">
      <bpmn:incoming>Flow_ToBe_Ing_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ToBe_Download" name="Download, extract text and pages">
      <bpmn:incoming>Flow_ToBe_Ing_03</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ing_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ToBe_BuildIndex" name="Split into passages and index">
      <bpmn:incoming>Flow_ToBe_Ing_05</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ing_06</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutput_ToBe_Index"><bpmn:targetRef>ToBe_Index</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ToBe_QualityChecks" name="Run automated quality checks">
      <bpmn:incoming>Flow_ToBe_Ing_06</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ing_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ToBe_QualityGate" name="Gate passed?">
      <bpmn:incoming>Flow_ToBe_Ing_07</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ing_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToBe_Ing_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ToBe_Publish" name="Publish index and coverage dates">
      <bpmn:incoming>Flow_ToBe_Ing_08</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ing_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ToBe_EndUpdated" name="Index updated">
      <bpmn:incoming>Flow_ToBe_Ing_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ToBe_KeepPrevious" name="Keep previous index; alert maintainer">
      <bpmn:incoming>Flow_ToBe_Ing_09</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBe_Ing_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ToBe_EndAlerted" name="Maintainer alerted">
      <bpmn:incoming>Flow_ToBe_Ing_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_01" sourceRef="ToBe_QuestionReceived" targetRef="ToBe_Retrieve" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_02" sourceRef="ToBe_Retrieve" targetRef="ToBe_PassagesFound" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_03" name="Yes" sourceRef="ToBe_PassagesFound" targetRef="ToBe_Draft" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_04" name="No" sourceRef="ToBe_PassagesFound" targetRef="ToBe_JoinNotFound" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_05" sourceRef="ToBe_Draft" targetRef="ToBe_CheckCitations" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_06" sourceRef="ToBe_CheckCitations" targetRef="ToBe_AllSupported" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_07" name="Yes" sourceRef="ToBe_AllSupported" targetRef="ToBe_Format" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_08" name="No" sourceRef="ToBe_AllSupported" targetRef="ToBe_JoinNotFound" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_09" sourceRef="ToBe_JoinNotFound" targetRef="ToBe_NotFound" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_10" sourceRef="ToBe_Format" targetRef="ToBe_JoinRespond" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_11" sourceRef="ToBe_NotFound" targetRef="ToBe_JoinRespond" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ans_12" sourceRef="ToBe_JoinRespond" targetRef="ToBe_ResponseSent" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_01" sourceRef="ToBe_Schedule" targetRef="ToBe_CheckPortal" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_02" sourceRef="ToBe_CheckPortal" targetRef="ToBe_NewMinutes" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_03" name="Yes" sourceRef="ToBe_NewMinutes" targetRef="ToBe_Download" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_04" name="No" sourceRef="ToBe_NewMinutes" targetRef="ToBe_EndNoChange" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_05" sourceRef="ToBe_Download" targetRef="ToBe_BuildIndex" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_06" sourceRef="ToBe_BuildIndex" targetRef="ToBe_QualityChecks" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_07" sourceRef="ToBe_QualityChecks" targetRef="ToBe_QualityGate" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_08" name="Yes" sourceRef="ToBe_QualityGate" targetRef="ToBe_Publish" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_09" name="No" sourceRef="ToBe_QualityGate" targetRef="ToBe_KeepPrevious" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_10" sourceRef="ToBe_Publish" targetRef="ToBe_EndUpdated" />
    <bpmn:sequenceFlow id="Flow_ToBe_Ing_11" sourceRef="ToBe_KeepPrevious" targetRef="ToBe_EndAlerted" />
    <bpmn:textAnnotation id="Annotation_ToBe_NoClaim">
      <bpmn:text>No claim without a citation (FR-02, FR-03)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Annotation_ToBe_NoClaim" associationDirection="None" sourceRef="ToBe_CheckCitations" targetRef="Annotation_ToBe_NoClaim" />
    <bpmn:textAnnotation id="Annotation_ToBe_Gate">
      <bpmn:text>Thresholds from NFR-01 and NFR-02</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Annotation_ToBe_Gate" associationDirection="None" sourceRef="ToBe_QualityChecks" targetRef="Annotation_ToBe_Gate" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FutureState" name="Finding what council decided: future state (to-be)">
    <bpmndi:BPMNPlane id="BPMNPlane_FutureState" bpmnElement="Collaboration_FutureState">
      <bpmndi:BPMNShape id="Participant_City_ToBe_di" bpmnElement="Participant_City_ToBe" isHorizontal="true">
        <dc:Bounds x="100" y="30" width="1340" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Staff_ToBe_di" bpmnElement="Lane_Staff_ToBe" isHorizontal="true">
