          <dc:Bounds x="1353" y="939" width="84" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="City_ProcessRequest_di" bpmnElement="City_ProcessRequest">
        <dc:Bounds x="1470" y="870" width="100" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="City_RequestClosed_di" bpmnElement="City_RequestClosed">
        <dc:Bounds x="1632" y="897" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1608" y="939" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_PP01_di" bpmnElement="Annotation_PP01">
        <dc:Bounds x="690" y="150" width="160" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_PP02_di" bpmnElement="Annotation_PP02">
        <dc:Bounds x="900" y="168" width="160" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_PP03_di" bpmnElement="Annotation_PP03">
        <dc:Bounds x="1080" y="168" width="160" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_PP04_di" bpmnElement="Annotation_PP04">
        <dc:Bounds x="930" y="802" width="170" height="40" />
