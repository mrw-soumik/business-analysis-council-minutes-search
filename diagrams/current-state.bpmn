      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="City_EnquiryClosed_di" bpmnElement="City_EnquiryClosed">
        <dc:Bounds x="1252" y="727" width="36" height="36" />
        <bpmndi:BPMNLabel>
