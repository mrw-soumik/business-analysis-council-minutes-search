      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_OpenMinutes_di" bpmnElement="AsIs_OpenMinutes">
        <dc:Bounds x="820" y="285" width="100" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_ReadFind_di" bpmnElement="AsIs_ReadFind">
        <dc:Bounds x="960" y="285" width="100" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Found_di" bpmnElement="AsIs_Found" isMarkerVisible="true">
